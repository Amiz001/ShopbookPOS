{
  "expo": {
    "name": "Shopbook POS",
    "slug": "shopbook-pos",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shopbookpos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.shopbook.pos",
      "version": "1.0.10",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "Shopbook POS requires Bluetooth to connect with thermal printers.",
        "NSBluetoothPeripheralUsageDescription": "Shopbook POS uses Bluetooth to connect with your thermal printer."
      }
    },
    "android": {
      "package": "lk.shopbook.pos",
      "version": "1.0.10",
      "versionCode": 11,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH_ADVERTISE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shopbook POS shares approximate device location with your store admin on the Active Devices panel.",
          "locationAlwaysAndWhenInUsePermission": "Shopbook POS shares approximate device location with your store admin on the Active Devices panel.",
          "locationAlwaysPermission": "Shopbook POS shares approximate device location with your store admin on the Active Devices panel."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB",
          "dark": {
            "backgroundColor": "#2563EB"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.nozbe.watermelondb.** { *; }\n-keep class com.bluetoothclassic.** { *; }\n-dontwarn com.bluetoothclassic.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3dfd340-0c26-4a74-9dd9-062842904f76"
      }
    },
    "runtimeVersion": "1.0.10",
    "owner": "shopbook_fayaz",
    "updates": {
      "url": "https://u.expo.dev/c3dfd340-0c26-4a74-9dd9-062842904f76"
    }
  }
}
